# Copy this file to .env (never commit .env). All values are optional.

# API server port. If you change it, also update the proxy target in client/vite.config.ts.
PORT=5000

# Browser origins allowed to call the API directly (comma-separated).
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional: where tickets are stored. Defaults to server/data/tickets.json.
# DATA_FILE=

# Optional real AI replies (server-side only). Leave the key empty to use rule-based templates.
ANTHROPIC_API_KEY=
# Model used when a key is set. Change it if your account uses a different model.
ANTHROPIC_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=15000
